# Installed dependencies (restore from the lockfiles)
/node_modules/
/vendor/

# Credentials and machine-specific configuration
.env
.env.*
!.env.example
/config/*.local.php
/config/*.local.json

# Database exports and private backups; allow deliberate schema/migration sources
*.sql
!/database/schema.sql
!/database/migrations/*.sql
/backups/
*.bak
*.backup
*.old
*.zip
*.7z
*.tar
*.gz

# Runtime uploads: existing tracked council records remain versioned for now
/uploads/**
!/uploads/.gitkeep

# Logs, caches, coverage and generated output
*.log
/logs/
/.cache/
/.npm/
/coverage/
/dist/
/build/
*.tsbuildinfo
__pycache__/
*.pyc

# Local source media and design references; commit prepared website assets instead.
/assets/reference/
/assets/static/1122(1).mp4
/assets/static/2026-2027 officers/
/assets/static/CSPC-Supreme-Student-Council-AY-2026-2027-Officers-Directory (2).pdf

# Machine-generated editor and operating-system files
/.vscode-test/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
