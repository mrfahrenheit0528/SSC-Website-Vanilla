Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
    AddType text/javascript .mjs
    AddType video/mp4 .mp4
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # These are source/dependency directories, not public routes.
    RewriteRule ^(?:\.git|\.vscode|config|database|vendor|node_modules|scripts|tests|backups)(?:/|$) - [F,L,NC]
</IfModule>

# Keep dumps, private config, manifests and backup files out of public responses.
<FilesMatch "(?i)(^\.env(?:\.|$)|^\.git|\.local\.php$|\.(?:sql|bak|backup|old|zip|7z|tar|gz|md)$|^(?:diagnostic\.php|test\.php|hello\.html|composer\.(?:json|lock)|package(?:-lock)?\.json)$)">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>
